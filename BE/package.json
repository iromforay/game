{
  "name": "be",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "prebuild": "npm run build:shared --prefix ..",
    "pretest": "npm run build:shared --prefix ..",
    "pretest:e2e": "npm run build:shared --prefix ..",
    "predev": "npm run build:shared --prefix ..",
    "predev:turby": "npm run build -w turby-stage-geometry --prefix ..",
    "predev:kirby": "npm run build:shared --prefix ..",
    "predev:sweet-shop": "npm run build -w sweet-shop-contracts --prefix ..",
    "dev": "ts-node --transpile-only src/main.ts",
    "dev:turby": "ts-node --transpile-only src/turby-main.ts",
    "dev:kirby": "ts-node --transpile-only src/kirby-main.ts",
    "dev:sweet-shop": "ts-node --transpile-only src/sweet-shop-main.ts",
    "dev:my-room-dungeon": "ts-node --transpile-only src/my-room-dungeon-main.ts",
    "dev:spin-gather": "ts-node --transpile-only src/spin-gather-main.ts",
    "dev:color-blasters": "ts-node --transpile-only src/color-blasters-main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:turby": "node dist/turby-main.js",
    "start:kirby": "node dist/kirby-main.js",
    "start:sweet-shop": "node dist/sweet-shop-main.js",
    "start:my-room-dungeon": "node dist/my-room-dungeon-main.js",
    "start:spin-gather": "node dist/spin-gather-main.js",
    "start:color-blasters": "node dist/color-blasters-main.js",
    "test": "node --experimental-strip-types --no-warnings --test -r ts-node/register/transpile-only test/*.test.ts",
    "test:color-blasters": "node --experimental-strip-types --no-warnings --test -r ts-node/register/transpile-only test/color-blasters.service.test.ts test/color-blasters.socket.test.ts",
    "test:color-blasters:production": "node --experimental-strip-types --no-warnings --test -r ts-node/register/transpile-only test/color-blasters.production-smoke.ts",
    "test:e2e": "node --no-warnings --test --test-concurrency=1 -r ts-node/register/transpile-only test/e2e/*.e2e.ts",
    "test:e2e:smoke": "npm run build -w turby-stage-geometry --prefix .. && node scripts/run-e2e-group.mjs smoke",
    "test:e2e:story": "npm run build -w turby-stage-geometry --prefix .. && node scripts/run-e2e-group.mjs story",
    "test:e2e:map": "npm run build -w turby-stage-geometry --prefix .. && node scripts/run-e2e-group.mjs map",
    "test:e2e:battle": "npm run build -w turby-stage-geometry --prefix .. && node scripts/run-e2e-group.mjs battle",
    "test:e2e:visual": "npm run build -w turby-stage-geometry --prefix .. && node scripts/run-e2e-group.mjs visual",
    "test:e2e:inventory": "npm run build -w turby-stage-geometry --prefix .. && node scripts/run-e2e-group.mjs inventory",
    "test:e2e:parallel": "npm run build -w turby-stage-geometry --prefix .. && node scripts/run-e2e-parallel.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/websockets": "^10.4.15",
    "@prisma/client": "^6.2.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "dotenv": "^16.4.7",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "sweet-shop-contracts": "*",
    "turby-stage-geometry": "*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "playwright-core": "^1.63.0",
    "prisma": "^6.2.1",
    "socket.io-client": "^4.8.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.3"
  }
}
