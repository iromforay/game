# 방(room) 상태는 기본적으로 서버 메모리에 보관됩니다.
# 서버를 여러 대로 스케일아웃할 때만 Redis pub/sub 어댑터를 켜서 인스턴스 간 브로드캐스트를 동기화하세요.
USE_REDIS_ADAPTER=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

PORT=3001
SWEET_SHOP_PORT=3005
SPIN_GATHER_PORT=3006
COLOR_BLASTERS_PORT=3007
SWEET_SHOP_MULTIPLAYER_ENABLED=true
# 서버 NPC 구매 작업. 판매 주기는 상품마다 최소~최대 범위에서 무작위로 예약됩니다.
SWEET_SHOP_NPC_PURCHASE_ENABLED=true
SWEET_SHOP_NPC_PURCHASE_INTERVAL_MS=5000
SWEET_SHOP_NPC_PURCHASE_MIN_SECONDS=45
SWEET_SHOP_NPC_PURCHASE_MAX_SECONDS=120

DATABASE_URL=mysql+pymysql://game:1djraks@54.180.81.50:3306/bosae?charset=utf8mb4

# 거래소 SSO. HUB_JWT_SECRET은 허브·거래소 BE에 동일한 32바이트 이상 값을 설정한다.
HUB_JWT_SECRET=
HUB_INTERNAL_API_KEY=
HUB_ACCESS_TOKEN_TTL_SECONDS=3600
HUB_REFRESH_TOKEN_TTL_SECONDS=1209600
HUB_COOKIE_DOMAIN=.bomul.ai.kr
# 쉼표로 구분. 비우면 개발 편의를 위해 요청 Origin을 허용한다.
HUB_CORS_ORIGINS=https://game.bomul.ai.kr,https://myplaymarket.bomul.ai.kr,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
