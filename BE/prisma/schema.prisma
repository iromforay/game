// 달콤상점 0단계 — account 기반 비동기 카페/거래 데이터
model sweet_shop_profile {
  account_id                 BigInt   @id @db.UnsignedBigInt
  cafe_name                  String   @default("나의 달콤상점") @db.VarChar(30)
  level                      Int      @default(1) @db.UnsignedInt
  experience                 Int      @default(0) @db.UnsignedInt
  gold                       Int      @default(100) @db.UnsignedInt
  first_cooking_tutorial_completed Boolean @default(false)
  representative_dessert_id  BigInt?  @db.UnsignedBigInt
  last_played_at             DateTime @default(now()) @db.Timestamp(0)
  created_at                 DateTime @default(now()) @db.Timestamp(0)
  updated_at                 DateTime @default(now()) @updatedAt @db.Timestamp(0)
}

model sweet_shop_storage {
  account_id             BigInt @id @db.UnsignedBigInt
  ingredient_slot_limit  Int    @default(12) @db.UnsignedSmallInt
  dessert_slot_limit     Int    @default(12) @db.UnsignedSmallInt
}

model sweet_shop_ingredient {
  account_id     BigInt @db.UnsignedBigInt
  ingredient_id String @db.VarChar(40)
  quality        Int    @default(1) @db.UnsignedTinyInt
  quantity       Int    @default(0) @db.UnsignedInt

  @@id([account_id, ingredient_id, quality])
}

model sweet_shop_delivery {
  id            BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  request_id    String                     @unique(map: "uq_sweet_delivery_request") @db.VarChar(64)
  account_id    BigInt                     @db.UnsignedBigInt
  ingredient_id String                     @db.VarChar(40)
  quality       Int                        @default(1) @db.UnsignedTinyInt
  quantity      Int                        @db.UnsignedInt
  total_price   Int                        @db.UnsignedInt
  status        sweet_shop_delivery_status @default(ordered)
  ordered_at    DateTime                   @default(now()) @db.Timestamp(0)
  arrives_at    DateTime                   @db.Timestamp(0)
  received_at   DateTime?                  @db.Timestamp(0)

  @@index([account_id, status, arrives_at], map: "idx_sweet_delivery_account")
}

enum sweet_shop_delivery_status {
  ordered
  arrived
  waiting_for_space
  received
}

model sweet_shop_recipe_progress {
  account_id          BigInt   @db.UnsignedBigInt
  recipe_id           String   @db.VarChar(40)
  mastery_level       Int      @default(1) @db.UnsignedInt
  mastery_experience  Int      @default(0) @db.UnsignedInt
  total_cooked        Int      @default(0) @db.UnsignedInt
  highest_quality     Int      @default(0) @db.UnsignedTinyInt
  unlocked_at         DateTime @default(now()) @db.Timestamp(0)

  @@id([account_id, recipe_id])
}

model sweet_shop_cooking_job {
  id             BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  request_id     String                    @unique(map: "uq_sweet_cooking_request") @db.VarChar(64)
  account_id     BigInt                    @db.UnsignedBigInt
  recipe_id      String                    @db.VarChar(40)
  quantity       Int                       @default(1) @db.UnsignedInt
  status         sweet_shop_cooking_status @default(cooking)
  started_at     DateTime                  @default(now()) @db.Timestamp(0)
  completes_at   DateTime                  @db.Timestamp(0)
  received_at    DateTime?                 @db.Timestamp(0)

  @@index([account_id, status], map: "idx_sweet_cooking_account")
}

enum sweet_shop_cooking_status {
  cooking
  waiting_for_space
  received
}

model sweet_shop_dessert {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  owner_id       BigInt   @db.UnsignedBigInt
  creator_id     BigInt   @db.UnsignedBigInt
  recipe_id      String   @db.VarChar(40)
  dessert_level  Int      @default(1) @db.UnsignedInt
  quality        Int      @default(1) @db.UnsignedTinyInt
  quantity       Int      @default(1) @db.UnsignedInt
  buff_type      String?  @db.VarChar(40)
  buff_value     Int      @default(0)
  created_at     DateTime @default(now()) @db.Timestamp(0)

  @@index([owner_id], map: "idx_sweet_dessert_owner")
  @@index([creator_id], map: "idx_sweet_dessert_creator")
}

model sweet_shop_listing {
  id          BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  request_id  String                    @unique(map: "uq_sweet_listing_request") @db.VarChar(64)
  seller_id   BigInt                    @db.UnsignedBigInt
  dessert_id  BigInt                    @db.UnsignedBigInt
  quantity    Int                       @db.UnsignedInt
  unit_price  Int                       @db.UnsignedInt
  status      sweet_shop_listing_status @default(active)
  listed_at   DateTime                  @default(now()) @db.Timestamp(0)
  sold_out_at DateTime?                 @db.Timestamp(0)

  @@index([seller_id, status], map: "idx_sweet_listing_seller")
  @@index([status, listed_at], map: "idx_sweet_listing_browse")
}

enum sweet_shop_listing_status {
  active
  sold_out
  removed
}

model sweet_shop_trade {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  request_id  String   @unique(map: "uq_sweet_trade_request") @db.VarChar(64)
  listing_id  BigInt   @db.UnsignedBigInt
  seller_id   BigInt   @db.UnsignedBigInt
  buyer_id    BigInt   @db.UnsignedBigInt
  dessert_id  BigInt   @db.UnsignedBigInt
  quantity    Int      @db.UnsignedInt
  unit_price  Int      @db.UnsignedInt
  total_price Int      @db.UnsignedInt
  created_at  DateTime @default(now()) @db.Timestamp(0)

  @@index([seller_id, created_at], map: "idx_sweet_trade_seller")
  @@index([buyer_id, created_at], map: "idx_sweet_trade_buyer")
}

model sweet_shop_guestbook {
  id                 BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  cafe_owner_id      BigInt   @db.UnsignedBigInt
  visitor_id         BigInt   @db.UnsignedBigInt
  message_code       String   @db.VarChar(40)
  sticker_code       String?  @db.VarChar(40)
  reply_sticker_code String?  @db.VarChar(40)
  created_at         DateTime @default(now()) @db.Timestamp(0)

  @@index([cafe_owner_id, created_at], map: "idx_sweet_guestbook_cafe")
}
