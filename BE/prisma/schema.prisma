generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model battle_result {
  id                                              BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  player_id                                       BigInt                       @db.UnsignedBigInt
  encounter_type                                  battle_result_encounter_type
  opponent_player_id                              BigInt?                      @db.UnsignedBigInt
  result                                          battle_result_result
  reward_tare                                     Int                          @default(0) @db.UnsignedInt
  reward_exp                                      Int                          @default(0) @db.UnsignedInt
  reward_item_json                                String?                      @db.LongText
  captured_turby_instance_id                      BigInt?                      @db.UnsignedBigInt
  created_at                                      DateTime                     @default(now()) @db.Timestamp(0)
  battle_id                                       BigInt?                      @db.UnsignedBigInt
  player_battle_result_player_idToplayer          player                       @relation("battle_result_player_idToplayer", fields: [player_id], references: [id], onUpdate: Restrict, map: "battle_result_ibfk_1")
  player_battle_result_opponent_player_idToplayer player?                      @relation("battle_result_opponent_player_idToplayer", fields: [opponent_player_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "battle_result_ibfk_2")
  turby_instance                                  turby_instance?              @relation(fields: [captured_turby_instance_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "battle_result_ibfk_3")

  @@unique([battle_id, player_id], map: "uq_battle_result_battle_player")
  @@index([captured_turby_instance_id], map: "captured_turby_instance_id")
  @@index([opponent_player_id], map: "opponent_player_id")
  @@index([player_id], map: "player_id")
}

model coop_battle {
  id                  BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  battle_key          String                @unique(map: "uq_coop_battle_key") @db.VarChar(40)
  room_code           String                @db.VarChar(10)
  stage_code          String                @db.VarChar(30)
  spawn_index         Int
  wild_character_code String                @db.VarChar(30)
  participant_count   Int
  result              coop_battle_result
  created_at          DateTime              @default(now()) @db.Timestamp(0)
}

model stage_wild_spawn {
  stage_code     String @db.VarChar(30)
  spawn_index    Int
  character_code String @db.VarChar(30)
  x              Int
  y              Int

  @@id([stage_code, spawn_index])
}

model item_definition {
  id              Int                      @id @default(autoincrement()) @db.UnsignedInt
  code            String                   @unique(map: "code") @db.VarChar(30)
  name            String                   @db.VarChar(50)
  category        item_definition_category
  description     String?                  @db.Text
  equip_slot      String?                  @db.VarChar(20)
  atk_bonus       Int                      @default(0)
  def_bonus       Int                      @default(0)
  ap_bonus        Int                      @default(0)
  hp_bonus        Int                      @default(0)
  // 스토리 M1(2026-09-29, docs/dev/save-a-turby/m0/m0_design.md 2.2) — 가방 칸 계산과 이야기 유물 슬롯
  max_stack            Int                    @default(1) @db.UnsignedSmallInt
  story_slot           String?                @db.VarChar(20)
  player_item          player_item[]
  turby_equipment      turby_equipment[]
  player_item_overflow player_item_overflow[]
}

model shop_product {
  id           Int                       @id @default(autoincrement()) @db.UnsignedInt
  product_type shop_product_product_type
  ref_code     String                    @db.VarChar(30)
  price_tare   Int                       @db.UnsignedInt
  sort_order   Int                       @default(0)
  is_active    Boolean                   @default(true)

  @@unique([product_type, ref_code], map: "uq_shop_product")
}

model shop_purchase {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  request_id        String   @unique(map: "uq_shop_purchase_request") @db.VarChar(64)
  player_id         BigInt   @db.UnsignedBigInt
  product_id        Int      @db.UnsignedInt
  price_tare        Int      @db.UnsignedInt
  turby_instance_id BigInt?  @db.UnsignedBigInt
  created_at        DateTime @default(now()) @db.Timestamp(0)

  @@index([player_id], map: "idx_shop_purchase_player")
}

model story_chapter {
  chapter_order        Int    @id
  stage_code           String @unique(map: "uq_story_chapter_stage") @db.VarChar(30)
  clear_character_code String @db.VarChar(30)
  title                String @db.VarChar(50)
  map_width            Int    @db.UnsignedInt
  map_height           Int    @db.UnsignedInt
}

model game_setting {
  setting_key String @id @db.VarChar(60)
  value_json  String @db.Text
}

model turby_equipment {
  id                 BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  turby_instance_id  BigInt          @db.UnsignedBigInt
  item_definition_id Int             @db.UnsignedInt
  slot_key           String          @db.VarChar(20)
  turby_instance     turby_instance  @relation(fields: [turby_instance_id], references: [id], onUpdate: Restrict)
  item_definition    item_definition @relation(fields: [item_definition_id], references: [id], onUpdate: Restrict)

  @@unique([turby_instance_id, slot_key], map: "uq_turby_slot")
  @@index([item_definition_id], map: "idx_turby_equipment_item")
}

model market_listing {
  id                                             BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  seller_player_id                               BigInt                @db.UnsignedBigInt
  turby_instance_id                              BigInt                @unique(map: "turby_instance_id") @db.UnsignedBigInt
  price_tare                                     Int                   @db.UnsignedInt
  status                                         market_listing_status @default(active)
  buyer_player_id                                BigInt?               @db.UnsignedBigInt
  listed_at                                      DateTime              @default(now()) @db.Timestamp(0)
  sold_at                                        DateTime?             @db.Timestamp(0)
  player_market_listing_seller_player_idToplayer player                @relation("market_listing_seller_player_idToplayer", fields: [seller_player_id], references: [id], onUpdate: Restrict, map: "market_listing_ibfk_1")
  player_market_listing_buyer_player_idToplayer  player?               @relation("market_listing_buyer_player_idToplayer", fields: [buyer_player_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "market_listing_ibfk_2")
  turby_instance                                 turby_instance        @relation(fields: [turby_instance_id], references: [id], onUpdate: Restrict, map: "market_listing_ibfk_3")

  @@index([buyer_player_id], map: "buyer_player_id")
  @@index([seller_player_id], map: "seller_player_id")
}

model player {
  id                                                     BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  device_uuid                                            String             @unique(map: "device_uuid") @db.VarChar(64)
  nickname                                               String             @db.VarChar(30)
  tare_balance                                           Int                @default(0) @db.UnsignedInt
  exp                                                    Int                @default(0) @db.UnsignedInt
  created_at                                             DateTime           @default(now()) @db.Timestamp(0)
  updated_at                                             DateTime           @default(now()) @db.Timestamp(0)
  // 스토리 M1: identify()가 발급하고 /player/me/* 와 소켓 hello가 검증(커비 kirby_player.session_token과 같은 방식)
  session_token                                          String?            @unique(map: "uq_player_session_token") @db.VarChar(64)
  battle_result_battle_result_player_idToplayer          battle_result[]    @relation("battle_result_player_idToplayer")
  battle_result_battle_result_opponent_player_idToplayer battle_result[]    @relation("battle_result_opponent_player_idToplayer")
  market_listing_market_listing_seller_player_idToplayer market_listing[]   @relation("market_listing_seller_player_idToplayer")
  market_listing_market_listing_buyer_player_idToplayer  market_listing[]   @relation("market_listing_buyer_player_idToplayer")
  player_base_slot                                       player_base_slot[]
  player_item                                            player_item[]
  turby_instance                                         turby_instance[]
  player_story_progress                                  player_story_progress?
  player_story_event                                     player_story_event[]
  player_story_objective_progress                        player_story_objective_progress[]
  player_item_overflow                                   player_item_overflow[]
}

model player_base_slot {
  id             BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  player_id      BigInt           @db.UnsignedBigInt
  slot_index     Int              @db.UnsignedTinyInt
  player         player           @relation(fields: [player_id], references: [id], onUpdate: Restrict, map: "player_base_slot_ibfk_1")
  turby_instance turby_instance[]

  @@unique([player_id, slot_index], map: "uq_player_slot")
}

model player_item {
  player_id          BigInt          @db.UnsignedBigInt
  item_definition_id Int             @db.UnsignedInt
  quantity           Int             @default(0) @db.UnsignedInt
  // 스토리 M1 인벤토리: 수량이 0이 되어도 행을 지우지 않는다(first_acquired_at = 수집 기록)
  first_acquired_at  DateTime?       @db.Timestamp(0)
  last_acquired_at   DateTime?       @db.Timestamp(0)
  is_new             Boolean         @default(false)
  is_locked          Boolean         @default(false)
  used_at            DateTime?       @db.Timestamp(0)
  player             player          @relation(fields: [player_id], references: [id], onUpdate: Restrict, map: "player_item_ibfk_1")
  item_definition    item_definition @relation(fields: [item_definition_id], references: [id], onUpdate: Restrict, map: "player_item_ibfk_2")

  @@id([player_id, item_definition_id])
  @@index([item_definition_id], map: "item_definition_id")
}

model turby_character {
  id             Int              @id @default(autoincrement()) @db.UnsignedInt
  code           String           @unique(map: "code") @db.VarChar(30)
  name           String           @db.VarChar(50)
  grade_id       Int              @db.UnsignedTinyInt
  atk_mod        Int              @default(0)
  def_mod        Int              @default(0)
  ap_mod         Int              @default(0)
  hp_mod         Int              @default(0)
  is_event       Boolean          @default(false)
  image_key      String?          @db.VarChar(100)
  description    String?          @db.Text
  created_at     DateTime         @default(now()) @db.Timestamp(0)
  turby_grade    turby_grade      @relation(fields: [grade_id], references: [id], onUpdate: Restrict, map: "turby_character_ibfk_1")
  turby_instance turby_instance[]

  @@index([grade_id], map: "grade_id")
}

model turby_grade {
  id                Int               @id @db.UnsignedTinyInt
  name              String            @db.VarChar(20)
  base_attack       Int?              @db.UnsignedInt
  base_defense      Int?              @db.UnsignedInt
  base_action_power Int?              @db.UnsignedInt
  base_hp           Int?              @db.UnsignedInt
  turby_character   turby_character[]
}

model turby_instance {
  id               BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  owner_player_id  BigInt                      @db.UnsignedBigInt
  character_id     Int                         @db.UnsignedInt
  nickname         String?                     @db.VarChar(30)
  current_hp       Int?                        @db.UnsignedInt
  acquired_via     turby_instance_acquired_via
  is_locked        Boolean                     @default(false)
  base_slot_id     BigInt?                     @db.UnsignedBigInt
  created_at       DateTime                    @default(now()) @db.Timestamp(0)
  atk_bonus        Int                         @default(0)
  def_bonus        Int                         @default(0)
  ap_bonus         Int                         @default(0)
  hp_bonus         Int                         @default(0)
  // 스토리 M1: 이야기 누비(판매·거래·폐기 불가). is_locked(사용자 잠금)와 섞어 쓰지 않는다
  is_story_companion Boolean                   @default(false)
  story_progress   player_story_progress?
  battle_result    battle_result[]
  market_listing   market_listing?
  turby_equipment  turby_equipment[]
  player_base_slot player_base_slot?           @relation(fields: [base_slot_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_turby_instance_base_slot")
  player           player                      @relation(fields: [owner_player_id], references: [id], onUpdate: Restrict, map: "turby_instance_ibfk_1")
  turby_character  turby_character             @relation(fields: [character_id], references: [id], onUpdate: Restrict, map: "turby_instance_ibfk_2")

  @@index([character_id], map: "character_id")
  @@index([base_slot_id], map: "fk_turby_instance_base_slot")
  @@index([owner_player_id], map: "owner_player_id")
}

// ===== 터비 구하기 스토리 모드 M1 (docs/dev/save-a-turby/m0/m0_design.md 2절, prisma/sql/2026-09-29_turby_story_m1.sql) =====

// 플레이어당 한 행. 장(chapter)은 checkpoint 접두어에서 계산한다.
model player_story_progress {
  player_id                    BigInt                       @id @db.UnsignedBigInt
  checkpoint                   String                       @default("OPENING_NOT_STARTED") @db.VarChar(40)
  story_nubi_turby_instance_id BigInt?                      @unique(map: "uq_story_nubi") @db.UnsignedBigInt
  nubi_growth_stage            Int                          @default(0) @db.UnsignedTinyInt
  origin                       player_story_progress_origin @default(new)
  created_at                   DateTime                     @default(now()) @db.Timestamp(0)
  updated_at                   DateTime                     @default(now()) @updatedAt @db.Timestamp(0)
  player                       player                       @relation(fields: [player_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  story_nubi                   turby_instance?              @relation(fields: [story_nubi_turby_instance_id], references: [id], onDelete: SetNull, onUpdate: Restrict)
}

enum player_story_progress_origin {
  new
  legacy_backfill
}

// 영구 효과의 멱등 키 — (player_id, event_id) unique가 마지막 방어선
model player_story_event {
  id           BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  player_id    BigInt                    @db.UnsignedBigInt
  event_id     String                    @db.VarChar(64)
  source       player_story_event_source @default(story)
  completed_at DateTime                  @default(now()) @db.Timestamp(0)
  player       player                    @relation(fields: [player_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([player_id, event_id], map: "uq_story_event")
}

enum player_story_event_source {
  story
  legacy_backfill
}

// 수집 오브젝트 한 개 = 한 행(실가루 dust_01~dust_10 등)
model player_story_objective_progress {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  player_id     BigInt   @db.UnsignedBigInt
  objective_key String   @db.VarChar(64)
  object_id     String   @db.VarChar(64)
  created_at    DateTime @default(now()) @db.Timestamp(0)
  player        player   @relation(fields: [player_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([player_id, objective_key, object_id], map: "uq_story_objective_object")
  @@index([player_id, objective_key], map: "idx_story_objective")
}

// 가방이 가득 찼을 때 일반 보상을 받아 두는 임시 보관함. 멱등 키는 플레이어 범위(player_id, source_key)
model player_item_overflow {
  id                 BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  player_id          BigInt          @db.UnsignedBigInt
  item_definition_id Int             @db.UnsignedInt
  quantity           Int             @db.UnsignedInt
  source_key         String          @db.VarChar(96)
  created_at         DateTime        @default(now()) @db.Timestamp(0)
  expires_at         DateTime?       @db.Timestamp(0)
  claimed_at         DateTime?       @db.Timestamp(0)
  player             player          @relation(fields: [player_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  item_definition    item_definition @relation(fields: [item_definition_id], references: [id], onUpdate: Restrict)

  @@unique([player_id, source_key], map: "uq_item_overflow_source")
  @@index([player_id, claimed_at], map: "idx_item_overflow_player")
  @@index([item_definition_id], map: "idx_item_overflow_item")
}

enum battle_result_encounter_type {
  wild
  raid
  story
}

enum item_definition_category {
  defense
  consumable
  upgrade
  equipment
  material
  mission
  relic
  memento
}

enum shop_product_product_type {
  turby
  item
}

enum battle_result_result {
  win
  lose
  draw
  cancelled
}

enum coop_battle_result {
  win
  lose
  draw
  cancelled
}

enum market_listing_status {
  active
  sold
  cancelled
}

enum turby_instance_acquired_via {
  shop
  wild_capture
  raid_rescue
  trade
  starter
}

// ===== 커비 훔치기(Steal a Kirby) — docs/Steal a Kirby.md 8번 =====
// 터비 구하기(turby_*)와는 완전히 별개 게임이라 kirby_ 접두어로 테이블 분리(같은 DB/레포는 공유, 7번 확정).

model kirby_grade {
  id              Int               @id @db.UnsignedTinyInt
  name            String            @db.VarChar(20)
  buy_price       Int               @db.UnsignedInt
  income_per_tick Int               @db.UnsignedInt
  sell_price      Int               @db.UnsignedInt
  kirby_character kirby_character[]
}

model kirby_character {
  id             Int              @id @default(autoincrement()) @db.UnsignedInt
  code           String           @unique(map: "kirby_character_code") @db.VarChar(30)
  name           String           @db.VarChar(50)
  grade_id       Int              @db.UnsignedTinyInt
  weight         Int              @db.UnsignedInt
  // 스폿 설정(2026-09-29, prisma/sql/2026-09-29_kirby_spawn.sql) — 꺼져 있거나 기간 밖이면 좌대 추첨에서 제외(보유분은 그대로)
  spawn_enabled   Boolean   @default(true)
  spawn_starts_at DateTime? @db.DateTime(0)
  spawn_ends_at   DateTime? @db.DateTime(0)
  image_key      String?          @db.VarChar(100)
  kirby_grade    kirby_grade      @relation(fields: [grade_id], references: [id], onUpdate: Restrict, map: "kirby_character_ibfk_1")
  kirby_instance kirby_instance[]

  @@index([grade_id], map: "grade_id")
}

model kirby_player {
  id                        BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  device_uuid               String                  @unique(map: "kirby_player_device_uuid") @db.VarChar(64)
  nickname                  String                  @db.VarChar(30)
  gold                      Int                     @default(0) @db.UnsignedInt
  // 4.4 확정: 기지 잠금 상태(열림/잠김/조건부잠김)
  lock_state                kirby_player_lock_state @default(open)
  // 잠김/조건부잠김은 설정 시점부터 60초 동안만 유지된다. null이면 만료 없음(열림).
  lock_expires_at           DateTime?               @db.Timestamp(3)
  // 4.4 조건부 잠김의 허용 유저 ID 목록 — 화이트리스트 방향으로 임시 채택(8.2-⑬ 최종 미확정), JSON 배열 문자열로 저장
  allowed_user_ids_json     String?                 @db.Text
  // 4.5 확정: 오프라인 기지 운영 여부
  offline_operation_enabled Boolean                 @default(true)
  // Codex QA 지적(2026-09-18, to_claude_v2_C.md §3-3) 반영: presence:hello가 임의 playerId를
  // 인증 없이 등록하던 문제 — identify() 시 발급하는 세션 토큰을 소켓 연결 때 함께 검증한다.
  session_token             String?                 @db.VarChar(64)
  created_at                DateTime                @default(now()) @db.Timestamp(0)
  updated_at                DateTime                @default(now()) @db.Timestamp(0)
  kirby_instance            kirby_instance[]

  @@index([lock_state], map: "lock_state")
}

model kirby_instance {
  id                BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  owner_player_id   BigInt                @db.UnsignedBigInt
  character_id      Int                   @db.UnsignedInt
  // 5.1 확정: 도둑맞는 중(stolen_in_transit)인 개체는 원 소유자 기지에서 실시간으로 음영/표시됨(6번)
  status            kirby_instance_status @default(idle)
  created_at        DateTime              @default(now()) @db.Timestamp(0)
  // 초당 발생 재화(2026-09-18 요청) 정산 기준 시각 — collectIncome()이 이 시각부터 경과 시간만큼 적립
  last_collected_at DateTime              @default(now()) @db.Timestamp(0)
  kirby_player      kirby_player          @relation(fields: [owner_player_id], references: [id], onUpdate: Restrict, map: "kirby_instance_ibfk_1")
  kirby_character   kirby_character       @relation(fields: [character_id], references: [id], onUpdate: Restrict, map: "kirby_instance_ibfk_2")

  @@index([owner_player_id], map: "owner_player_id")
  @@index([character_id], map: "character_id")
}

enum kirby_player_lock_state {
  open
  locked
  conditional
}

enum kirby_instance_status {
  idle
  stolen_in_transit
}

// 허브 공통 계정(2026-09-28, prisma/sql/2026-09-28_account.sql) — 아이디+비밀번호, 기기 통합 목적.
// 게임 테이블(kirby_player/player)은 그대로 device_uuid 기반으로 두고, account_game_player 브리지로만 연결한다.
model account {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  login_id      String   @unique(map: "uq_account_login_id") @db.VarChar(20)
  password_hash String   @db.VarChar(255)
  nickname      String   @db.VarChar(30)
  // 관리자 백오피스(2026-09-29, prisma/sql/2026-09-29_admin.sql) — 'admin'만 /admin/* 사용 가능
  role          account_role @default(user)
  created_at    DateTime @default(now()) @db.Timestamp(0)
  updated_at    DateTime @default(now()) @db.Timestamp(0)
}

enum account_role {
  user
  admin
}

// 관리자 조작 기록(2026-09-29) — 백오피스에서 바꾼 모든 값의 전후
model admin_log {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  admin_account_id BigInt   @db.UnsignedBigInt
  action           String   @db.VarChar(40)
  target_type      String   @db.VarChar(20)
  target_id        String   @db.VarChar(40)
  before_json      String?  @db.Text
  after_json       String?  @db.Text
  created_at       DateTime @default(now()) @db.Timestamp(0)

  @@index([created_at], map: "idx_admin_log_created")
  @@index([target_type, target_id], map: "idx_admin_log_target")
}

// 허브 계정 ↔ 게임별 플레이어 브리지(계정당 게임별 1개, 게임 플레이어당 계정 1개)
model account_game_player {
  id         BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  account_id BigInt                   @db.UnsignedBigInt
  game       account_game_player_game
  player_id  BigInt                   @db.UnsignedBigInt
  created_at DateTime                 @default(now()) @db.Timestamp(0)

  @@unique([account_id, game], map: "uq_agp_account_game")
  @@unique([game, player_id], map: "uq_agp_game_player")
}

enum account_game_player_game {
  kirby
  turby
}

model account_session {
  token_hash String   @id @db.Char(64)
  account_id BigInt   @db.UnsignedBigInt
  created_at DateTime @default(now()) @db.Timestamp(0)

  @@index([account_id], map: "idx_account_session_account")
}

// 스코어보드(2026-09-28, prisma/sql/2026-09-28_score_record.sql, docs/dev/scoreboard.md) — 로그인 플레이어의 판 결과
model score_record {
  id          BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  account_id  BigInt            @db.UnsignedBigInt
  game        score_record_game
  round_id    Int               @default(0) @db.UnsignedInt
  score       Int
  detail_json String?           @db.Text
  // 진행 중 갱신되는 판(디펜스 타워·오펜스 타워)의 판 식별자 — 판당 한 행
  run_key     String?           @unique(map: "uq_score_run") @db.VarChar(64)
  created_at  DateTime          @default(now()) @db.Timestamp(0)

  @@index([game, round_id, score], map: "idx_score_rank")
  @@index([account_id, game, round_id], map: "idx_score_account")
}

enum score_record_game {
  tower_defense
  offense_tower
  number_hero_tower
  number_gate_runner
  merge_defense
  marbles
}

model merge_defense_profile {
  account_id        BigInt   @id @db.UnsignedBigInt
  silver            Int      @default(0) @db.UnsignedInt
  attack_level      Int      @default(0) @db.UnsignedInt
  warrior_unlocked    Int    @default(1) @db.UnsignedInt
  archer_unlocked     Int    @default(1) @db.UnsignedInt
  spellblade_unlocked Int    @default(0) @db.UnsignedInt
  spellblade_recipe_unlocked Boolean @default(false)
  start_coin_level        Int      @default(0) @db.UnsignedInt
  summon_discount_level   Int      @default(0) @db.UnsignedInt
  highest_cleared_stage   Int      @default(0) @db.UnsignedInt
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamp(0)
}

model merge_defense_silver_claim {
  run_key     String   @id @db.VarChar(64)
  account_id  BigInt   @db.UnsignedBigInt
  stage_id    Int      @db.UnsignedInt
  silver      Int      @db.UnsignedInt
  kills       Int      @db.UnsignedInt
  created_at  DateTime @default(now()) @db.Timestamp(0)

  @@index([account_id], map: "idx_merge_silver_account")
}

// 내 방이 던전 — 계정별 영구 진행 저장
model my_room_dungeon_profile {
