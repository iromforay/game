# 게임 플레이 로그 (IndexedDB, 로컬 전용) - .env 또는 .env.local로 복사해서 사용
# 'false'로 설정하면 로깅을 완전히 끔. 미설정 시 기본값은 켜짐.
VITE_GAME_LOG_ENABLED=true

# 이 일수보다 오래된 로그는 앱 로드 시 자동 삭제됨. 미설정 시 무제한 보관.
VITE_GAME_LOG_RETENTION_DAYS=30

# 멀티 모드가 접속할 BE(NestJS + Socket.IO) 서버 주소
VITE_MULTIPLAYER_SERVER_URL=http://localhost:3001

# 터비 구하기 BE(NestJS + Socket.IO) 서버 주소. 배포 시 실제 접속 가능한 주소로 변경 (프록시 사용 권장)
VITE_TURBY_SERVER_URL=http://localhost:3002

# 커비 훔치기 BE(kirby-be, NestJS + Socket.IO) 서버 주소. 배포 시 실제 접속 가능한 주소로 변경
VITE_KIRBY_SERVER_URL=http://localhost:3003

# 내 방이 던전 BE(my-room-dungeon-be, NestJS) 서버 주소. 배포 시 실제 접속 가능한 주소로 변경
VITE_MY_ROOM_DUNGEON_SERVER_URL=http://localhost:3004
VITE_SWEET_SHOP_SERVER_URL=http://localhost:3005
# 빙글 채집왕
SPIN_GATHER_SERVER_URL=http://localhost:3006

# 컬러 블래스터즈 전용 Socket.IO 서버
VITE_COLOR_BLASTERS_SERVER_URL=http://localhost:3007
